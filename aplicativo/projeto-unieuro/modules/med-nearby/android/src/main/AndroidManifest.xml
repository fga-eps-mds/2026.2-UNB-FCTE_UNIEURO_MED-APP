<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!--
    Permissões do Nearby. São pedidas ao usuário só ao sincronizar.
    tools:replace/remove: valem as faixas de versão daqui.
  -->
  <!-- O Nearby 19.3.0 exige as de Wi-Fi em todas as versões (erros 8032 e 8033). -->
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"
    tools:remove="android:maxSdkVersion" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"
    tools:remove="android:maxSdkVersion" />
  <uses-permission android:maxSdkVersion="30" android:name="android.permission.BLUETOOTH"
    tools:replace="android:maxSdkVersion" />
  <uses-permission android:maxSdkVersion="30" android:name="android.permission.BLUETOOTH_ADMIN"
    tools:replace="android:maxSdkVersion" />
  <!-- Localização também em todas as versões (erro 8034 no Android 16). -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
    tools:remove="android:maxSdkVersion" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
    tools:remove="android:minSdkVersion,android:maxSdkVersion" />
  <uses-permission android:minSdkVersion="31" android:name="android.permission.BLUETOOTH_ADVERTISE"
    tools:replace="android:minSdkVersion" />
  <uses-permission android:minSdkVersion="31" android:name="android.permission.BLUETOOTH_CONNECT"
    tools:replace="android:minSdkVersion" />
  <uses-permission android:minSdkVersion="31" android:name="android.permission.BLUETOOTH_SCAN"
    tools:replace="android:minSdkVersion" />
  <uses-permission android:minSdkVersion="32" android:name="android.permission.NEARBY_WIFI_DEVICES"
    tools:replace="android:minSdkVersion" />
  <uses-permission android:minSdkVersion="37" android:name="android.permission.ACCESS_LOCAL_NETWORK"
    tools:replace="android:minSdkVersion" />
</manifest>
